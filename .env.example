# GitHub OAuth Configuration
# Create a GitHub OAuth App at https://github.com/settings/applications/new
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback
# Required for self-hosted OAuth. Serve site/dashboard.html at this exact URL.
# The callback carries its own validated API origin to this dashboard; that
# origin is then used for the one-time exchange and every later API request.
OAUTH_DASHBOARD_URL=http://localhost:4173/dashboard.html

# Database Configuration
DATABASE_URL=octostore.db

# Server Configuration
BIND_ADDR=0.0.0.0:3000

# Disabled by default. May only be enabled with an explicit numeric loopback
# BIND_ADDR and cannot be combined with OAuth or static token sources.
LOCAL_REGISTRATION=false

# Account-free leader elections (enabled by default)
PUBLIC_ELECTIONS=true
MAX_PUBLIC_ELECTIONS=10000
PUBLIC_ELECTION_REQUESTS_PER_MINUTE=600
# Concurrent best-effort election watch streams
PUBLIC_ELECTION_WATCH_STREAMS_GLOBAL=1024
PUBLIC_ELECTION_WATCH_STREAMS_PER_CLIENT=8
# Force clients to reconnect and reconcile after 15 minutes
PUBLIC_ELECTION_WATCH_MAX_SECONDS=900

# Additional private CA roots for outbound webhooks. The CLI honors the same variable.
# OCTOSTORE_CA_BUNDLE=/etc/octostore/private-ca-bundle.pem

# Outbound webhooks deny localhost plus private, link-local, and reserved
# addresses by default, including after DNS resolution on every delivery.
# Enable only for an intentionally private self-hosted network with:
# OCTOSTORE_WEBHOOK_ALLOW_PRIVATE_NETWORKS=true
OCTOSTORE_WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# Optional: Logging Configuration
RUST_LOG=octostore_lock=debug
